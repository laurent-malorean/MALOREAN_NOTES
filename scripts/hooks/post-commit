#!/usr/bin/env bash
# Après un commit qui touche crates/domain : test de mutation du domaine, en arrière-plan, non bloquant
# (scripts/mutation-diff.sh). Posé par scripts/install-hooks.sh. Les autres commits ne lancent rien.
# Marche aussi depuis un `git worktree` : le dossier de travail courant, verdicts communs.
root=$(git rev-parse --show-toplevel) || exit 0
sha=$(git rev-parse HEAD)
git diff-tree --no-commit-id --name-only -r --root "$sha" | grep -q '^crates/domain/.*\.rs$' || exit 0
dir=$(git rev-parse --path-format=absolute --git-common-dir)/ci-mutation
mkdir -p "$dir"
nohup "$root/scripts/mutation-diff.sh" "$sha" >"$dir/journal.log" 2>&1 </dev/null &
disown 2>/dev/null || true
exit 0
