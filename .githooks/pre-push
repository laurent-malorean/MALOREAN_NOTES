#!/usr/bin/env bash
# Garde-fou : aucun push si la mini CI échoue, ni si une erreur introduite dans le code
# Rust envoyé passe inaperçue des tests (test de mutation limité à ce qui part).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
readonly NO_COMMIT=0000000000000000000000000000000000000000

since=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$NO_COMMIT" ] && continue
  if [ "$remote_sha" = "$NO_COMMIT" ]; then
    since="tout"
  elif [ "$since" != "tout" ]; then
    since="$remote_sha"
  fi
done

case "$since" in
  "") exec "$root/scripts/ci.sh" ;;
  tout) exec "$root/scripts/ci.sh" --complet ;;
  *) exec "$root/scripts/ci.sh" --mutations-depuis "$since" ;;
esac
