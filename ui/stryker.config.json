{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/bridge/generated/**",
    "!src/main.ts",
    "!src/essai/index.ts",
    "!src/essai/scenarios/**"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "reporters": ["clear-text", "html"],
  "htmlReporter": {
    "fileName": "../build/reports/mutation/index.html"
  },
  "tempDirName": "../build/stryker-tmp",
  "cleanTempDir": "always",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
