{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MALOREAN Notes",
  "version": "../../ui/package.json",
  "identifier": "com.malorean.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../build/ui-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MALOREAN Notes",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "devCsp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "externalBin": ["binaries/malorean-writing"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
